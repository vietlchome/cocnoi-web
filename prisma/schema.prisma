// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMS (PostgreSQL Native Enums)
// ---------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  RETAIL
  B2B_WHOLESALE
  B2B_CONSIGNMENT
  B2B_GIFT
}

enum InquiryStatus {
  PENDING
  CONTACTED
  NEGOTIATING
  CONVERTED
  CANCELLED
}

enum InquiryType {
  RETAIL_B2C        // Đặt lẻ cá nhân
  WHOLESALE_B2B     // Đăng ký đại lý / stockist
  CORPORATE_B2B     // Quà tặng doanh nghiệp
  CONTACT_GENERAL   // Liên hệ chung chưa có intent mua
}

enum CustomerType {
  RETAIL_LEAD
  RETAIL_BUYER
  B2B_LEAD
  B2B_WHOLESALE
  B2B_CONSIGNMENT
  B2B_GIFT
}

enum Visibility {
  PUBLIC
  B2B_ONLY
  HIDDEN
}

// ---------------------------------------------------------
// MODULE 1: XÁC THỰC NGƯỜI DÙNG (AUTH.JS STANDARD)
// ---------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hỗ trợ đăng nhập Credentials (Email/Password)
  role          UserRole  @default(USER)

  accounts      Account[]
  sessions      Session[]
  orders        Order[]   // Quan hệ với Module 4
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------
// MODULE 2: PIM (SẢN PHẨM & DANH MỤC)
// ---------------------------------------------------------

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  products  Product[]
  sizes     SizeOption[] // Quan hệ với Kích cỡ tùy chọn ( dependent size options )
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ProductGroup {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ColorOption {
  id        String    @id @default(cuid())
  name      String    @unique
  hex       String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SizeOption {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([name, categoryId])
}

model Product {
  id               String        @id @default(cuid())
  sku              String?       @unique // Mã sản phẩm (SKU)
  name             String
  slug             String        @unique
  shortDescription String?       // Trích dẫn / Mô tả ngắn
  description      String
  price            Int
  compareAtPrice   Int?          // Giá so sánh / Giá gốc trước khi giảm
  stockQuantity    Int           @default(0)
  weight           Int?          @default(0) // Khối lượng sản phẩm (grams)
  images           String[]      // Mảng ảnh (tối đa 6 ảnh)
  
  // Các trường phục vụ Flat Catalog (Mỗi Màu/Cỡ là 1 sản phẩm)
  productGroupId   String?       // Mã nhóm liên kết các sản phẩm cùng bộ sưu tập
  productGroup     ProductGroup? @relation(fields: [productGroupId], references: [id], onDelete: SetNull)

  colorId          String?       // Khóa ngoại trỏ đến ColorOption
  color            ColorOption?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  sizeId           String?       // Khóa ngoại trỏ đến SizeOption
  size             SizeOption?   @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  isActive         Boolean       @default(true) // Phục vụ tính năng Soft Delete
  visibility       Visibility    @default(PUBLIC) // PUBLIC | B2B_ONLY (Kiểm soát hiển thị sản phẩm)

  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  orderItems       OrderItem[]   // Quan hệ với Module 4
  inquiries        OrderInquiry[] // Quan hệ với các đơn tư vấn gốm (Module 3)
  reviews          Review[]      // Đánh giá sản phẩm từ người dùng
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([categoryId])
  @@index([productGroupId])
  @@index([isActive, visibility])
}

// ---------------------------------------------------------
// MODULE 4: QUẢN LÝ ĐƠN HÀNG
// ---------------------------------------------------------

model Order {
  id              String        @id @default(cuid())
  userId          String?       // Cho phép khách mua vãng lai không cần tài khoản
  user            User?         @relation(fields: [userId], references: [id])
  
  customerId      String?       // Liên kết với CRM Customer
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  totalAmount     Int
  shippingAddress String        // Lưu JSON string hoặc Text về địa chỉ
  
  status          OrderStatus   @default(PENDING)
  paymentStatus   Boolean       @default(false)
  paidAmount      Int           @default(0) // Số tiền đã thanh toán (để theo dõi công nợ B2B)
  debtAmount      Int           @default(0) // Số tiền còn nợ
  orderType       OrderType     @default(RETAIL) // RETAIL | B2B_CONSIGNMENT | B2B_GIFT | B2B_WHOLESALE
  discount        Int           @default(0) // Số tiền chiết khấu (đặc biệt cho B2B)
  note            String?       // Ghi chú nội bộ cho Admin
  
  items           OrderItem[]
  sourceInquiryId   String?       @unique
  sourceInquiry     OrderInquiry? @relation(name: "OrderSourceInquiry", fields: [sourceInquiryId], references: [id], onDelete: SetNull)
  convertedInquiry  OrderInquiry? @relation(name: "InquiryConvertedOrder")
  review          Review?       // Đánh giá đã xác thực cho đơn hàng này
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([orderType])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  quantity        Int
  priceAtPurchase Int             // Ghi nhận giá sản phẩm tại thời điểm mua (Tránh sai lệch khi giá SP đổi)
  originalPrice   Int             @default(0) // Giá bán lẻ gốc lúc mua (để tính toán chiết khấu B2B)
}

// ---------------------------------------------------------
// MODULE 3: ĐƠN TƯ VẤN ĐẶT GỐM (ORDER INQUIRY)
// ---------------------------------------------------------

model OrderInquiry {
  id           String        @id @default(cuid())
  customerName String
  phone        String
  email        String?
  companyName  String?
  
  customerId   String?       // Liên kết với CRM Customer
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  quantity     Int           @default(1)
  note         String?
  source       String?       // Dấu vết xem khách gửi form từ đâu (ví dụ slug sản phẩm, trang Đối Tác, v.v.)
  
  status       InquiryStatus @default(PENDING)
  
  inquiryType       InquiryType   @default(RETAIL_B2C)
  convertedOrderId  String?       @unique
  convertedOrder    Order?        @relation(name: "InquiryConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  sourceOrder       Order?        @relation(name: "OrderSourceInquiry")
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, inquiryType, createdAt])
  @@index([customerId])
  @@index([productId])
}

// ---------------------------------------------------------
// MODULE 7: CRM - QUẢN LÝ KHÁCH HÀNG
// ---------------------------------------------------------

model Customer {
  id           String         @id @default(cuid())
  name         String
  phone        String         @unique // Định danh duy nhất theo SĐT
  email        String?
  companyName  String?
  address      String?
  taxCode      String?
  
  customerType CustomerType   @default(RETAIL_LEAD)
  
  orders       Order[]
  inquiries    OrderInquiry[]
  notes        CustomerNote[] // Liên kết đến nhật ký chăm sóc
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([customerType])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// MODULE 9: CONTENT (BLOG CMS & THEME CUSTOMIZER)
// ---------------------------------------------------------

model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  excerpt         String?     @db.Text
  content         String      @db.Text   // Markdown raw
  coverImage      String?     // Cloudinary URL (featured image)
  category        String      @default("UNCATEGORIZED") // Phân loại bài viết
  
  metaTitle       String?     // SEO meta title (fallback to title)
  metaDescription String?     @db.Text   // SEO meta description (fallback to excerpt)
  ogImage         String?     // Cloudinary URL OG (fallback to coverImage)
  
  authorName      String?     @default("Cốc Nối")
  tags            String[]    @default([])
  
  status          PostStatus  @default(DRAFT)
  publishedAt     DateTime?   // null nếu DRAFT
  scheduledFor    DateTime?   // optional scheduled publish
  
  readingTime     Int?        // Lưu integer field
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model ThemeSetting {
  id        String   @id @default(cuid())
  key       String   @unique          // e.g. "hero.title", "color.primary"
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}




model Review {
  id           String   @id @default(cuid())
  orderId      String   @unique  // Mỗi đơn hàng lẻ chỉ review 1 lần duy nhất
  productId    String
  rating       Int      // 1-5 sao
  comment      String?
  customerName String
  order        Order    @relation(fields: [orderId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  createdAt    DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ---------------------------------------------------------
// MODULE 10: PROMOTIONS & CAMPAIGNS
// ---------------------------------------------------------

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id                 String        @id @default(cuid())
  name               String
  code               String?       @unique // Null nếu là tự động giảm
  type               PromotionType @default(PERCENTAGE)
  isAutomatic        Boolean       @default(false)
  value              Int           // Mức giảm (ví dụ: 10 cho 10%, hoặc 50000 cho 50k)
  minOrderValue      Int           @default(0) // Giá trị đơn tối thiểu để áp dụng
  startDate          DateTime      @default(now())
  endDate            DateTime?
  usageLimit           Int?          // Số lượt dùng tối đa, null nếu không giới hạn
  usedCount            Int           @default(0)
  isActive             Boolean       @default(true)
  canCombine           Boolean       @default(true) // Có được cộng dồn với khuyến mãi khác hay không
  
  // Điều kiện áp dụng (Nếu tất cả rỗng = Toàn shop)
  appliedCategoryIds   String[]      // Mảng ID category
  appliedCollectionIds String[]      // Mảng ID collection
  appliedProductCodes  String[]      // Mảng Mã sản phẩm (sku hoặc code)
  appliedSizes         String[]      // Mảng Size
  appliedColors        String[]      // Mảng Màu sắc
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// ---------------------------------------------------------
// MODULE 11: SYSTEM NOTIFICATIONS
// ---------------------------------------------------------

enum NotificationType {
  ORDER
  INQUIRY
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  link      String?          // Đường dẫn để điều hướng khi click
  
  createdAt DateTime         @default(now())

  @@index([isRead, createdAt])
}



